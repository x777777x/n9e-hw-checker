# /etc/logrotate.d/kernel-hw-mon
{{ hw_mon_log_file }} {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root {{ hw_mon_user }}
    su root {{ hw_mon_user }}
    postrotate
        /usr/bin/systemctl kill -s HUP rsyslog 2>/dev/null || true
    endscript
}
